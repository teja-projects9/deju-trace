        <mxCell id="tabs" value="Call Tree · Breakdown · Flame Graph · Timeline · Findings&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;five tabs, one payload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Each tab reads the same payload and builds lazily on first open.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A4C;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="1234.0" width="1352.0" height="92.0" as="geometry" /></mxCell>
