<mxfile host="app.diagrams.net" modified="2026-08-20T00:00:00.000Z" agent="deju-trace" version="24.7.17" type="device">
  <diagram id="deju-trace-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0" />
