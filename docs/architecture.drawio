        <mxCell id="title" value="How Deju Trace actually works" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="40.0" y="0.0" width="1400.0" height="30.0" as="geometry" /></mxCell>
        <mxCell id="zone_plugin_bg" value="YOUR IDE  —  the Deju Trace plugin" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FC;strokeColor=#2F6FD0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#2F6FD0;shadow=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="1400.0" height="414.0" as="geometry" /></mxCell>
        <mxCell id="zone_plugin_blurb" value="A JetBrains plugin. Talks to your running app through exactly one channel: a local socket to the agent." style="text;html=1;fontFamily=Helvetica;fontSize=11.5;align=left;verticalAlign=top;fontColor=#5B6572;" vertex="1" parent="1"><mxGeometry x="58.0" y="72.0" width="1364.0" height="30.0" as="geometry" /></mxCell>
        <mxCell id="zone_plugin_tab" value="" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="6.0" height="414.0" as="geometry" /></mxCell>
        <mxCell id="zone_agent_bg" value="YOUR APPLICATION&#x27;S JVM  —  the Deju Agent" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCF0E3;strokeColor=#C2680A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#C2680A;shadow=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="544.0" width="1400.0" height="414.0" as="geometry" /></mxCell>
        <mxCell id="zone_agent_blurb" value="A -javaagent, attached at JVM start. Lives inside the process it traces and nowhere else." style="text;html=1;fontFamily=Helvetica;fontSize=11.5;align=left;verticalAlign=top;fontColor=#5B6572;" vertex="1" parent="1"><mxGeometry x="58.0" y="576.0" width="1364.0" height="30.0" as="geometry" /></mxCell>
        <mxCell id="zone_agent_tab" value="" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="544.0" width="6.0" height="414.0" as="geometry" /></mxCell>
        <mxCell id="zone_report_bg" value="A BROWSER  —  the exported report" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#1F8A4C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F8A4C;shadow=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="1048.0" width="1400.0" height="302.0" as="geometry" /></mxCell>
        <mxCell id="zone_report_blurb" value="One HTML file. No agent, no plugin, no IDE and no network needed to open it." style="text;html=1;fontFamily=Helvetica;fontSize=11.5;align=left;verticalAlign=top;fontColor=#5B6572;" vertex="1" parent="1"><mxGeometry x="58.0" y="1080.0" width="1364.0" height="30.0" as="geometry" /></mxCell>
        <mxCell id="zone_report_tab" value="" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#1F8A4C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="1048.0" width="6.0" height="302.0" as="geometry" /></mxCell>
        <mxCell id="edge_bundle" value="" style="edgeStyle=none;rounded=0;html=1;orthogonal=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#5B6572;strokeWidth=1.6;fontFamily=Courier New;fontSize=10.5;fontColor=#5B6572;labelBackgroundColor=#FBFBFA;align=center;" edge="1" parent="1" source="bundle" target="patcher"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
        <mxCell id="edge_attach" value="−javaagent flag, at JVM start" style="edgeStyle=none;rounded=0;html=1;orthogonal=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B6572;strokeWidth=1.6;fontFamily=Courier New;fontSize=10.5;fontColor=#5B6572;labelBackgroundColor=#FBFBFA;align=center;" edge="1" parent="1" source="patcher" target="dejuagent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="568.5" y="499.0" /><mxPoint x="397.0" y="499.0" /></Array><mxPoint x="0.0" y="-8.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="edge_socket" value="AUTH → ARM/DISARM ↓   ·   JSON payload ↑" style="edgeStyle=none;rounded=0;html=1;orthogonal=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#5B6572;strokeWidth=1.6;fontFamily=Courier New;fontSize=10.5;fontColor=#5B6572;labelBackgroundColor=#FBFBFA;align=center;" edge="1" parent="1" source="agentclient" target="socketserver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="225.5" y="521.0" /><mxPoint x="1083.0" y="521.0" /></Array><mxPoint x="0.0" y="8.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="edge_export" value="Export — standalone from here on" style="edgeStyle=none;rounded=0;html=1;orthogonal=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=6 4;strokeColor=#5B6572;strokeWidth=1.6;fontFamily=Courier New;fontSize=10.5;fontColor=#5B6572;labelBackgroundColor=#FBFBFA;align=center;" edge="1" parent="1" source="reportgen" target="reporthtml"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480.0" y="384.0" /><mxPoint x="1480.0" y="1168.0" /></Array><mxPoint x="58.0" y="-10.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="toolwindow" value="Tool Window&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuToolWindowPanel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Connect, set a trace point, Track / Show / Export, and the run history list.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="114.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="toolwindow_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="114.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="controller" value="Controller&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuController&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Owns the agent connection; hands a landed payload to the painter and history store.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="521.3" y="114.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="controller_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="521.3" y="114.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="settings" value="Settings&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuSettings&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Host, port, token, Includes, exclusions, history capacity (1–25).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="978.7" y="114.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="settings_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="978.7" y="114.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="painter" value="Editor Painter&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;EditorPainter · TimingGutterProvider&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Paints executed lines (green/yellow/red) and per-line timing into the gutter.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="226.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="painter_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="226.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="resolver" value="Source Resolver&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;SourceResolver · TypeNavigator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Maps a recorded class back to its source file across configured source roots.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="407.0" y="226.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="resolver_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="407.0" y="226.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="exclusions" value="Exclusions&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuExclusions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Entities/DTOs/builders folded away by default. Resolved at export time only.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="750.0" y="226.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="exclusions_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="750.0" y="226.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="history" value="History Store&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuHistoryStore&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Last N runs (1–25) as JSON in .idea/deju/, ring-buffered. Pinned runs survive rotation.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="1093.0" y="226.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="history_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1093.0" y="226.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="agentclient" value="Agent Client&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;AgentClient&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Connects to the agent&amp;#x27;s token-gated socket: AUTH, ARM/DISARM, reads pushed JSON payloads.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="338.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="agentclient_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="338.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="patcher" value="Auto-Attach&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuProgramPatcher&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Adds the -javaagent flag to IDE-launched run configurations automatically.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="407.0" y="338.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="patcher_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="407.0" y="338.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="bundle" value="Agent Bundle&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuAgentBundle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Unpacks the bundled agent jar to a real file on disk for -javaagent to point at.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="750.0" y="338.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="bundle_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="750.0" y="338.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="reportgen" value="Report Generator&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;HtmlReportGenerator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Builds the exported file: inlines report.css/js and the gzip+base64 payload.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F6FD0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="1093.0" y="338.0" width="323.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="reportgen_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FD0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1093.0" y="338.0" width="323.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="dejuagent" value="Agent Entry&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;DejuAgent (premain)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Attached via -javaagent:...=port=,token=,includes=. Wires the socket + runtime.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="618.0" width="666.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="dejuagent_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="618.0" width="666.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="socketserver" value="Socket Server&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;SocketServer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Loopback-only by default. AUTH &amp;lt;token&amp;gt; compared in constant time; bad token closes the socket.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="750.0" y="618.0" width="666.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="socketserver_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="750.0" y="618.0" width="666.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="instrumenter" value="Bytecode Instrumentation&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;AsmInstrumenter · CoverageClassVisitor · CoverageMethodVisitor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Rewrites classes matching Includes as they load: entry/exit, line and branch probes. Stack-neutral.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="730.0" width="1352.0" height="92.0" as="geometry" /></mxCell>
        <mxCell id="instrumenter_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="730.0" width="1352.0" height="3.0" as="geometry" /></mxCell>
        <mxCell id="runtime" value="Runtime + Session&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;CoverageRuntime · Session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Target of every probe. Per-thread; records line hits, branches, call tree, CPU time.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="842.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="runtime_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="842.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="sql" value="SQL Capture&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;agent.sql&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Wraps JDBC execute*; statement text only, bound parameters never read.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="521.3" y="842.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="sql_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="521.3" y="842.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="payloadbuilder" value="Payload Builder&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;PayloadBuilder&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;Turns a Session&amp;#x27;s hit-sets into the wire DejuPayload: FULL/PARTIAL/NONE, call tree, CPU µs.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2680A;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="978.7" y="842.0" width="437.3" height="92.0" as="geometry" /></mxCell>
        <mxCell id="payloadbuilder_hl" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2680A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="978.7" y="842.0" width="437.3" height="3.0" as="geometry" /></mxCell>
        <mxCell id="reporthtml" value="report.html&lt;br&gt;&lt;font style=&quot;font-family: Courier New; font-size: 9.5px; font-weight: normal; color: #5B6572;&quot;&gt;self-contained&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-family: Helvetica; font-size: 9.5px; font-weight: normal; color: #1F2328;&quot;&gt;report.css and report.js inlined; payload gzipped + base64&amp;#x27;d into the file itself.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A4C;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;fontFamily=Helvetica;fontSize=12.5;fontStyle=1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="64.0" y="1122.0" width="1352.0" height="92.0" as="geometry" /></mxCell>
